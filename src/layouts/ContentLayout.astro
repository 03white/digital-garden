---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import type { GardenEntry } from '../lib/content';
import { formatDate, getEntryDate, getEntryDescription, getEntryPublishedDate, getNoteStatusLabel } from '../lib/content';

interface Props {
  entry: GardenEntry;
}

const { entry } = Astro.props;
const isNote = entry.collection === 'notes';
---

<BaseLayout title={entry.data.title} description={getEntryDescription(entry)}>
  <article class="content-page">
    <header class="content-header">
      <p class="eyebrow">{isNote ? '花园笔记' : '博客文章'}</p>
      <h1>{entry.data.title}</h1>
      <p class="content-description">{getEntryDescription(entry)}</p>
      <div class="content-meta">
        <span>发布：{formatDate(getEntryPublishedDate(entry))}</span>
        <span>更新：{formatDate(getEntryDate(entry))}</span>
        {isNote && <span>状态：{getNoteStatusLabel(entry.data.status)}</span>}
      </div>
      {entry.data.tags.length > 0 && (
        <div class="tag-list" aria-label="标签">
          {entry.data.tags.map((tag) => <Tag name={tag} />)}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
