---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getEntriesByTag } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getAllTags();

  return tags.map((tag) => ({
    params: { tag: encodeURIComponent(tag.name) },
    props: { tag: tag.name },
  }));
}

const { tag } = Astro.props;
const entries = await getEntriesByTag(tag);
---

<BaseLayout title={`标签：${tag}`} description={`所有带有 ${tag} 标签的内容。`}>
  <section class="page-heading">
    <p class="eyebrow">Tag</p>
    <h1>#{tag}</h1>
    <p>这个标签下共有 {entries.length} 条内容。</p>
  </section>
  <div class="entry-list">
    {entries.map((entry) => <PostCard entry={entry} />)}
  </div>
</BaseLayout>
