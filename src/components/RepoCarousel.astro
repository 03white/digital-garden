---
import { getLanguageColor } from '../lib/colors';
import type { RepoCard } from '../lib/github';
import { SITE } from '../lib/site';

/**
 * GitHub 仓库轮播。
 *
 * 滚动本身完全交给 CSS（`overflow-x: auto` + `scroll-snap-type`），所以触摸滑动、
 * 鼠标拖拽、键盘、惯性全部是原生的。脚本只做两件事：点箭头时 scrollBy 一格，
 * 以及根据滚动位置同步圆点和箭头的禁用态。没有 JS 时它就是一条可横向滚动的卡片列。
 */

interface Props {
  repos: RepoCard[];
}

const { repos } = Astro.props;
---

<section class="section-block carousel" data-carousel>
  <div class="section-heading">
    <h2>我的项目</h2>
    <div class="carousel-controls">
      <a class="carousel-all" href={`https://github.com/${SITE.githubUser}`} target="_blank" rel="noreferrer">全部仓库</a>
      <button class="carousel-arrow" type="button" data-carousel-prev aria-label="上一个项目">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 6-6 6 6 6" />
        </svg>
      </button>
      <button class="carousel-arrow" type="button" data-carousel-next aria-label="下一个项目">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 6 6 6-6 6" />
        </svg>
      </button>
    </div>
  </div>

  <div class="carousel-track" data-carousel-track tabindex="0" role="group" aria-label="GitHub 项目">
    {repos.map((repo) => (
      <article class="repo-card">
        <a class="repo-card-title" href={repo.url} target="_blank" rel="noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8" />
          </svg>
          {repo.name}
        </a>
        <p class="repo-card-desc">{repo.description}</p>
        <div class="repo-card-meta">
          {repo.language && (
            <span class="repo-card-lang">
              <span class="repo-card-lang-dot" style={`background:${getLanguageColor(repo.language)}`} aria-hidden="true"></span>
              {repo.language}
            </span>
          )}
          {repo.stars > 0 && (
            <span class="repo-card-stars">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="m12 2.6 2.9 5.88 6.5.95-4.7 4.58 1.11 6.47L12 17.43l-5.81 3.05L7.3 14 2.6 9.43l6.5-.95z" />
              </svg>
              {repo.stars}
            </span>
          )}
          {repo.topics.map((topic) => <span class="repo-card-topic">{topic}</span>)}
        </div>
      </article>
    ))}
  </div>

  <div class="carousel-dots" data-carousel-dots role="tablist" aria-label="项目分页">
    {repos.map((repo, index) => (
      <button class="carousel-dot" type="button" role="tab" data-carousel-dot={index} aria-label={`跳到 ${repo.name}`}></button>
    ))}
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-carousel-track]');

  if (carousel && track) {
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    const slides = [...track.children] as HTMLElement[];

    /** 一格的距离取两张卡片的左边距差，这样 gap 改了也不用同步这里。 */
    const step = () =>
      slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth;

    /** 离容器左边最近的那张卡就是「当前」。 */
    const currentIndex = () => {
      let best = 0;
      let bestDistance = Number.POSITIVE_INFINITY;

      slides.forEach((slide, index) => {
        const distance = Math.abs(slide.offsetLeft - track.scrollLeft);

        if (distance < bestDistance) {
          bestDistance = distance;
          best = index;
        }
      });

      return best;
    };

    /**
     * 末尾几张卡永远同屏出现，滚不到「它在最左边」的位置，对应的圆点点了也没反应。
     * 所以圆点只保留真正可达的滚动位置，数量随视口变化。
     */
    const reachableCount = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;

      return maxScroll <= 1 ? 1 : Math.round(maxScroll / step()) + 1;
    };

    let queued = false;

    const sync = () => {
      queued = false;

      const index = currentIndex();
      const reachable = reachableCount();
      // 用 1px 容差吸收滚动位置的小数误差，否则末尾按钮可能永远不禁用。
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;

      dots.forEach((dot, dotIndex) => {
        dot.hidden = dotIndex >= reachable;
        dot.setAttribute('aria-selected', dotIndex === index ? 'true' : 'false');
      });

      prev?.toggleAttribute('disabled', atStart);
      next?.toggleAttribute('disabled', atEnd);
    };

    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(sync);
      }
    };

    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        track.scrollTo({ left: slides[index]?.offsetLeft ?? 0, behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    sync();

    // ── 自动播放 ──
    const INTERVAL_MS = 4200;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;

    const advance = () => {
      const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;

      // 走到头就绕回开头，形成循环。
      track.scrollTo({
        left: atEnd ? 0 : track.scrollLeft + step(),
        behavior: 'smooth',
      });
    };

    const play = () => {
      // 只有一屏放得下时没什么可轮播的。
      if (timer || reduceMotion.matches || track.scrollWidth <= track.clientWidth + 1) {
        return;
      }

      timer = window.setInterval(advance, INTERVAL_MS);
    };

    const pause = () => {
      if (timer) {
        clearInterval(timer);
        timer = 0;
      }
    };

    // 悬停暂停只挂在轨道上，不挂整个 section——否则鼠标停在标题那一片
    // （section 横跨整个内容宽度）就再也不动了，看起来像坏了。
    track.addEventListener('pointerenter', pause);
    track.addEventListener('pointerleave', play);
    carousel.addEventListener('focusin', pause);
    carousel.addEventListener('focusout', play);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    reduceMotion.addEventListener('change', () => (reduceMotion.matches ? pause() : play()));
    // 窗口变宽可能让一整排卡片放得下（于是不该再轮播），变窄则相反，两边都要重新判断。
    window.addEventListener('resize', () => {
      pause();
      play();
    });

    play();
  }
</script>
